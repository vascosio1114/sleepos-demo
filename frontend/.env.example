# SleepOS — example environment configuration.
#
# Copy this file to `.env.local` and fill in the values. `.env.local`
# and any real `.env` are gitignored.
#
# All provider identifiers are config only. Domain code reads these via
# `shared/constants/provider-config-keys.ts`; never access `process.env`
# from inside domain modules.
#
# See:
#   docs/SHARED_KEYS.md §10 — canonical registry
#   docs/A2A_VOICE_BRAIN_INTEGRATION_PLAN.md §4.4 — TTS decision
#   docs/decisions/ADR-002 — provider boundary decision

# ─── Runtime mode ───────────────────────────────────────────────
# `mock` runs entirely with synthetic providers; no external calls.
# `live` requires all provider keys below to be present.
SLEEPOS_PROVIDER_MODE=mock

# ─── Provider selection ─────────────────────────────────────────
SLEEPOS_STT_PROVIDER=mock
SLEEPOS_ADVICE_PROVIDER=mock
SLEEPOS_TTS_PROVIDER=mock

# ─── Voice language ─────────────────────────────────────────────
# en-US is the primary MVP locale. Other locales are reserved for
# future markets and are not enabled in MVP.
SLEEPOS_STT_DEFAULT_LANGUAGE=en-US

# ─── Audio retention ────────────────────────────────────────────
# `none` is the only safe default. `enabled_storage` and
# `research_grant` require explicit consent + privacy / legal review
# per ADR-002 §4 and must NOT be enabled in MVP.
SLEEPOS_VOICE_AUDIO_RETENTION=none

# ─── Google Cloud Speech-to-Text V2 (only when SLEEPOS_STT_PROVIDER=google_stt_v2) ─
# Standard Google service-account credential path. Server-only.
GOOGLE_APPLICATION_CREDENTIALS=
SLEEPOS_GOOGLE_STT_PROJECT_ID=

# ─── MiniMax (text + TTS) ───────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_; the build pipeline
# blocks `NEXT_PUBLIC_MINIMAX_*` and `NEXT_PUBLIC_GOOGLE_*` env names.
#
# Provisioning checklist (do this before flipping SLEEPOS_PROVIDER_MODE=live):
#   ☐ Account created at the MiniMax platform with billable quota.
#   ☐ API key minted; stored only in `.env.local`; never logged.
#   ☐ Region confirmed (data residency + retention).
#   ☐ Text model identifier chosen and tested against the eval suite.
#   ☐ TTS voice identifier chosen; TTS line tested with `escalationCopy`.
#   ☐ Privacy / security reviewer signed off on no-raw-audio default.
#   ☐ Independent review of Task 10 + Task 11 contracts complete.
#   ☐ Knowledge module has ≥ ≥ approved entries.

# Required when SLEEPOS_ADVICE_PROVIDER=minimax or SLEEPOS_TTS_PROVIDER=minimax_tts
MINIMAX_API_KEY=

# Optional override; defaults to the MiniMax production endpoint.
MINIMAX_API_BASE_URL=

# Optional override; recommended defaults documented in ADR-003.
MINIMAX_TEXT_MODEL=
MINIMAX_TTS_MODEL=
MINIMAX_TTS_VOICE=

# ─── Knowledge + eval (server-side, optional) ──────────────────
# Path to the approved knowledge bundle JSONL (default: docs/knowledge/approved/*.jsonl).
SLEEPOS_KNOWLEDGE_BUNDLE_PATH=
# Path to the safety evaluation suite JSONL (default: tests/evaluations/safety/v*-cases.jsonl).
SLEEPOS_EVAL_SUITE_PATH=

# ─── Frontend public runtime (P0 demo defaults; preserved) ─────
NEXT_PUBLIC_SLEEPOS_RUNTIME_MODE=demo
NEXT_PUBLIC_BODY_MODEL_VERSION=
NEXT_PUBLIC_BODY_MODEL_URL=
NEXT_PUBLIC_SKIN_MODEL_URL=

# ─── Optional Supabase (Phase 4 pilot; not used in MVP) ─────────
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional analytics (provider / consent required first) ────
ANALYTICS_PROVIDER_KEY=