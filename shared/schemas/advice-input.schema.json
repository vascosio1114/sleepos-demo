{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepos.local/schemas/advice-input.schema.json",
  "title": "ValidatedAdviceInput",
  "description": "Pre-validated input to an AdviceProvider. Domain must validate before invoking the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "localDate",
    "language",
    "checkin",
    "observations",
    "knowledgeChunkIds",
    "allowedActionTypes",
    "maxSpeakableTextChars",
    "safetyClassification",
    "knowledgeVersion",
    "promptVersion"
  ],
  "properties": {
    "userId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "language": { "type": "string", "enum": ["en-US", "en-GB", "zh-HK", "yue-Hant-HK"] },
    "checkin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkinId", "userId", "capturedAt", "sleepMinutes", "sleepQualityScore", "stressScore", "moodScore", "focusScore", "confirmedNote"],
      "properties": {
        "checkinId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sleepMinutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 1440 },
        "sleepQualityScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "stressScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "moodScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "focusScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "confirmedNote": { "type": ["string", "null"], "maxLength": 600 }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "statement", "evidenceMetricKeys", "uncertainty"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidenceMetricKeys": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "uncertainty": { "type": "string", "minLength": 1, "maxLength": 280 }
        }
      }
    },
    "knowledgeChunkIds": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "allowedActionTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["brain_training", "breathing", "sleep_goal", "routine"] }
    },
    "maxSpeakableTextChars": { "type": "integer", "minimum": 60, "maximum": 600 },
    "safetyClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasonCodes", "requiresProfessionalReferral", "requiresImmediateEscalation"],
      "properties": {
        "level": { "type": "string", "enum": ["green", "amber", "red"] },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "crisis_self_harm",
              "crisis_medical_emergency",
              "diagnosis_request",
              "medication_change_request",
              "sustained_decline_self_report",
              "conflicting_metric_signals",
              "minor_low_risk_wellness",
              "no_signals"
            ]
          }
        },
        "requiresProfessionalReferral": { "type": "boolean" },
        "requiresImmediateEscalation": { "type": "boolean" }
      }
    },
    "knowledgeVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "promptVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
  }
}