{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepos.local/schemas/safety-classification.schema.json",
  "title": "SafetyClassification",
  "description": "Three-level safety router output (green / amber / red). Used to gate advice generation and select copy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "reasonCodes",
    "requiresProfessionalReferral",
    "requiresImmediateEscalation",
    "copyId",
    "evidence"
  ],
  "properties": {
    "level": { "type": "string", "enum": ["green", "amber", "red"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "crisis_self_harm",
          "crisis_medical_emergency",
          "diagnosis_request",
          "medication_change_request",
          "sustained_decline_self_report",
          "conflicting_metric_signals",
          "minor_low_risk_wellness",
          "no_signals"
        ]
      }
    },
    "requiresProfessionalReferral": { "type": "boolean" },
    "requiresImmediateEscalation": { "type": "boolean" },
    "copyId": { "type": "string", "enum": ["wellnessDisclaimer", "escalationCopy", "wellnessScope"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reasonCode", "matchedPatternId"],
        "properties": {
          "reasonCode": { "type": "string", "enum": ["crisis_self_harm", "crisis_medical_emergency", "diagnosis_request", "medication_change_request", "sustained_decline_self_report", "conflicting_metric_signals", "minor_low_risk_wellness", "no_signals"] },
          "matchedPatternId": { "type": "string", "maxLength": 80 }
        }
      }
    }
  }
}