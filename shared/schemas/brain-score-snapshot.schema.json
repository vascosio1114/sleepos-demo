{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepos.local/schemas/brain-score-snapshot.schema.json",
  "title": "BrainScoreSnapshot",
  "description": "Functional-domain + optional regional brain scores. regionalScores default empty unless a qualified qEEG / HEG source produced them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "userId",
    "capturedAt",
    "protocolVersion",
    "mode",
    "assessorId",
    "domains",
    "regionalScores",
    "fiveDScores",
    "disclaimerKey"
  ],
  "properties": {
    "snapshotId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "protocolVersion": { "type": "string", "const": "brain-domain-v1" },
    "mode": {
      "type": "string",
      "enum": ["demo", "self_report", "cognitive_task", "qEEG", "HEG"]
    },
    "assessorId": { "type": ["string", "null"], "maxLength": 64 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "score", "status", "measured", "sourceMetricKeys", "quality"],
        "properties": {
          "key": { "type": "string", "enum": ["attention", "regulation", "memory", "sleep_arousal"] },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "status": { "type": "string", "enum": ["good", "attention", "no_data"] },
          "measured": { "type": "boolean" },
          "sourceMetricKeys": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "quality": { "type": "string", "enum": ["acceptable", "marginal", "poor", "unverified"] }
        }
      }
    },
    "regionalScores": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brainKey", "score"],
        "properties": {
          "brainKey": {
            "type": "string",
            "enum": ["frontal", "prefrontal", "parietal", "temporal", "occipital", "central", "amygdala", "hippocampus", "cingulate", "insula"]
          },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "protocolVersion": { "type": "string", "maxLength": 40 },
          "assessorId": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "fiveDScores": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "score", "explanation"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["energy_metabolism", "network_connectivity", "symmetrical_balance", "depth_state", "functional_performance"]
          },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "disclaimerKey": { "type": "string", "const": "wellness_not_diagnosis" }
  }
}